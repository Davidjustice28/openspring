DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Required for Census population/income data
CENSUS_API_KEY=

# Recommended for USGS OGC API rate limits (environmental snapshot cards)
USGS_API_KEY=

# Optional: recent state water legislation (Open States)
OPEN_STATES_API_KEY=

# Optional: irrigated farmland acres (USDA NASS Quick Stats)
NASS_API_KEY=

# Optional: protects POST /api/analytics/internal/* snapshot jobs
SNAPSHOT_SECRET=

# Optional: run full snapshot ingest when the API starts (use cron/scripts in production)
SNAPSHOT_INGEST_ON_STARTUP=0

# Used when IP is localhost/private (local dev). Optional. Omit for national default on localhost.
GEOIP_DEFAULT_STATE=utah

RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com
PORT=3001
# Local Vite dev only (proxied /api by default). Leave unset in production —
# the API serves the built frontend from the same origin.
VITE_API_URL=http://localhost:3001
# Optional override for the Vite build directory (default: ../frontend/dist)
# FRONTEND_DIST=
TRUST_PROXY=1
